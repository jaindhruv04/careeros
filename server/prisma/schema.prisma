generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int              @id @default(autoincrement())
  email            String           @unique
  name             String?
  password         String
  createdAt        DateTime         @default(now())
  dsaproblems      DSAProblem[]
  companies        Company[]
  projects         Project[]
  interviewEntries InterviewEntry[]
}

model DSAProblem {
  id             Int      @id @default(autoincrement())
  name           String
  topic          String
  difficulty     String
  status         String
  solvedDate     DateTime?
  priority       String
  revisionNeeded Boolean  @default(false)
  notes          String?
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id              Int      @id @default(autoincrement())
  name            String
  role            String
  status          String
  applicationDate String?
  priority        String
  notes           String?
  archived        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id        Int      @id @default(autoincrement())
  name      String
  techStack String
  progress  Int      @default(0)
  status    String
  priority  String
  notes     String?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InterviewEntry {
  id              Int      @id @default(autoincrement())
  company         String
  round           String
  questionsAsked  String?
  myAnswer        String?
  mistakes        String?
  lessonsLearned  String?
  priority        String
  notes           String?
  archived        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
